# ===========================
# Project Management Backend
# ===========================
#
# FastAPI runs on port 3001 in this template.
# Database container is PostgreSQL exposed on port 5000 per work item.

# ---- Database (safe defaults match the provided DB container) ----
DB_HOST=localhost
DB_PORT=5000
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123

# Optional override for SQLAlchemy. If set, it takes precedence over the fields above.
# Example:
# DATABASE_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp
# DATABASE_URL=

# ---- Auth/JWT ----
# In production, set a strong secret and rotate as needed.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ---- CORS (frontend -> backend) ----
# Comma-separated list. Use "*" to allow any origin (not recommended for production).
# Local dev frontend commonly runs on http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=3600

# ---- Server ----
HOST=0.0.0.0
PORT=3001
